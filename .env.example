# انسخ هذا الملف باسم .env وعدّل القيم. لا ترفع ملف .env إلى GitHub أبدًا.

MADAR_ENV=development
# في الإنتاج: قيمة عشوائية طويلة. تولّدها بـ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# مفتاح تشفير رقم الهوية والآيبان (إجباري في الإنتاج). تولّده بـ: flask --app wsgi gen-data-key
# احفظه في مكان آمن منفصل عن النسخ الاحتياطية: ضياعه يعني ضياع هذي البيانات
DATA_KEY=
COMPANY_NAME=شركة Example للمقاولات
BASE_URL=http://127.0.0.1:5000

# قاعدة البيانات: SQLite للتجربة. مع Docker تُضبط PostgreSQL تلقائيًا
DATABASE_URL=sqlite:///madar.db
AUTO_CREATE_TABLES=true

# Docker فقط
DOMAIN=hr.example.com
POSTGRES_PASSWORD=change-me-too

# البريد: console يطبع في الطرفية (للتجربة)، smtp يرسل فعليًا
MAIL_BACKEND=console
MAIL_FROM=Madar HR <hr@example.com>
# للتجربة الآمنة: كل الرسائل تروح لهذا البريد بدل بريد الموظفين
MAIL_REDIRECT_TO=
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# الدخول بحسابات الشركة: microsoft أو google (اتركه فاضي للتعطيل)
OIDC_PROVIDER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# لـ Microsoft: معرّف الـ Tenant (GUID) الخاص بالشركة. إجباري، والنظام يرفض الدخول بدونه
OIDC_TENANT=
# يسمح فقط ببريد هذا الدومين
OIDC_ALLOWED_DOMAIN=

# التحقق بخطوتين إجباري للإدارة والرواتب والمسؤول التقني
REQUIRE_2FA=False

# الذكاء الاصطناعي: يحتاج المفتاح + تفعيل من صفحة الإعدادات بعد موافقة الشركة
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001

# في الإنتاج مع HTTPS
SESSION_COOKIE_SECURE=false
# true فقط إذا التطبيق خلف Caddy (Docker يضبطها تلقائيًا)
TRUST_PROXY=false
# الجلسة تنتهي بعد 30 دقيقة خمول، وبحد أقصى 10 ساعات
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=10
APPROVAL_TOKEN_HOURS=48
DAILY_RUN_HOUR=6
